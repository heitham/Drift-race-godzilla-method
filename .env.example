# Copy to .env.local and fill in. Never commit the real file — .env.local is gitignored.

# --- models -----------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- the CMS under test -----------------------------------------------------
# Path to the RIFT CMS checkout. The pin check reads HEAD here before every run,
# to confirm the renderer has not moved underneath a benchmark in progress.
CMS_REPO=/path/to/rift-cms

# Postgres holding the CMS database.
DATABASE_URL=postgres://localhost:5432/cms_dev

# MCP endpoint the governed arm talks to.
RIFT_MCP_URL=http://localhost:3001/api/mcp

# --- two keys, two roles, and the separation is load-bearing -----------------
# Agent-role key. The model under test uses this one and can never approve or
# publish its own work; that ceiling is the governance model being measured.
RIFT_API_KEY=

# Admin-role key, held by the HARNESS, which plays the reviewer between
# operations. Must be a different key from the one above — collapsing them into
# one would silently delete the thing this benchmark exists to test.
RIFT_ADMIN_KEY=
